---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const pages = [
  { href: '/', label: 'Home', note: 'Overview of the school and current news' },
  { href: '/about', label: 'About Us', note: 'Vision, mission, and our five pillars' },
  { href: '/academics', label: 'Academics', note: 'Classical curriculum for grades K-8' },
  { href: '/athletics', label: 'Athletics', note: 'Sports programs and after-school activities' },
  { href: '/enrollment', label: 'Enrollment', note: 'How to pre-enroll your student' },
  { href: '/contact', label: 'Contact', note: 'Email addresses and how to reach us' },
  { href: '/support-and-sponsorship', label: 'Support and Sponsorship', note: 'Donate or become a sponsor' },
  { href: '/dress-code', label: 'Dress Code', note: 'Uniform requirements' },
  { href: '/code-of-conduct', label: 'Code of Conduct', note: 'Behavior expectations' },
  { href: '/privacy', label: 'Privacy Policy', note: 'How we handle information on this site' },
];

const machineReadable = [
  { href: '/sitemap.xml', label: '/sitemap.xml', note: 'Full list of indexable URLs' },
  { href: '/llms.txt', label: '/llms.txt', note: 'Agent instructions and when to use this site' },
  { href: '/robots.txt', label: '/robots.txt', note: 'Crawl rules' },
];
---

<Layout
  title="Page Not Found (404)"
  description="This page could not be found on pbasa.org. Use the site map below to find what you are looking for."
  noindex={true}
>
  <PageHero
    title="Page Not Found"
    subtitle="The page you requested does not exist. Here is where everything lives."
  />

  <section class="section-padding bg-white">
    <div class="container-narrow max-w-4xl">
      <p class="text-navy-600 text-lg leading-relaxed mb-10">
        HTTP 404 &mdash; no page exists at this address. If you followed a link, it may be out of date.
        The site map below lists every page on pbasa.org.
      </p>

      <h2 class="text-2xl font-heading font-bold text-navy-900 mb-2">Site map</h2>
      <div class="gold-divider mb-6"></div>
      <ul class="space-y-3 mb-12">
        {pages.map((page) => (
          <li class="flex flex-col sm:flex-row sm:items-baseline sm:gap-3">
            <a href={page.href} class="text-gold-600 hover:text-gold-700 font-semibold">{page.label}</a>
            <span class="text-navy-500 text-sm">{page.note}</span>
          </li>
        ))}
      </ul>

      <h2 class="text-2xl font-heading font-bold text-navy-900 mb-2">For AI agents and crawlers</h2>
      <div class="gold-divider mb-6"></div>
      <ul class="space-y-3">
        {machineReadable.map((file) => (
          <li class="flex flex-col sm:flex-row sm:items-baseline sm:gap-3">
            <a href={file.href} class="text-gold-600 hover:text-gold-700 font-mono text-sm">{file.label}</a>
            <span class="text-navy-500 text-sm">{file.note}</span>
          </li>
        ))}
      </ul>
      <p class="text-navy-500 text-sm mt-6">
        Every page is also available as Markdown: request it with <code class="font-mono">Accept: text/markdown</code>,
        or append <code class="font-mono">.md</code> to the path.
      </p>
    </div>
  </section>
</Layout>
